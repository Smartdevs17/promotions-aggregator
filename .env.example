NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
DATABASE_URL=postgres://promotions:promotions@localhost:5432/promotions
TEST_DATABASE_URL=postgres://promotions:promotions@localhost:5432/promotions_test
REDIS_URL=redis://localhost:6379
SOURCE_PORTAL_URL=https://www.thepromenadeshopsatbriargate.com/sales
SCRAPER_USER_AGENT=PromotionsAggregatorTakeHome/1.0
SCRAPER_REQUEST_DELAY_MS=500
SCRAPER_CONCURRENCY=2
JOB_TIMEOUT_MS=600000
QUEUE_SUBMISSION_TIMEOUT_MS=5000
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
# BullMQ uses the TLS Redis protocol URL, not the REST URL/token directly.
# Example: rediss://default:<redis-password>@<database>.upstash.io:6379
